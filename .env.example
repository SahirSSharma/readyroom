# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
YOUCAM_API_KEY=

# Generate at least 32 random characters. Keep stable across deployments.
SESSION_SECRET=

# Must belong to a PRIVATE Vercel Blob store. Required in production.
BLOB_READ_WRITE_TOKEN=

# Optional development/test overrides; ignored in production.
# STORE_FORCE_LOCAL=true
# STORE_LOCAL_DIR=.local/workspaces
